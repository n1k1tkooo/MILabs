# ==============================================================================
# Переменные окружения для DocuMind AI Backend (Образец .env.example)
# Внимание: Реальный файл .env добавлен в .gitignore и не коммитится в репозиторий
# ==============================================================================

# 1. Серверные настройки
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# 2. Подключение к базе данных PostgreSQL (On-premise контур)
POSTGRES_DB=documind_db
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=secure_onpremise_pwd_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://documind_user:secure_onpremise_pwd_2026@localhost:5432/documind_db

# 3. Безопасность и CORS (Разрешенные адреса фронтенда)
JWT_SECRET=super_secret_jwt_hmac_sha256_key_for_152fz_compliance
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# 4. Российские AI-модели (Yandex Cloud API)
YANDEX_GPT_API_KEY=AQVN_SAMPLE_KEY_EXAMPLE_ONLY
YANDEX_FOLDER_ID=b1g_sample_folder_id

# 5. On-premise OpenSource LLM (DeepSeek / Qwen через Ollama/vLLM)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_ONPREMISE_MODEL=deepseek-r1:8b
