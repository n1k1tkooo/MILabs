# Базовые параметры сервера
PORT=8000
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql://documind_admin:SecretEnterprisePassword152FZ!@localhost:5432/documind_prod

# 1. OAuth2: Яндекс ID (SSO для сотрудников РФ, 152-ФЗ)
YANDEX_CLIENT_ID=documind_yandex_app_prod_9918
YANDEX_CLIENT_SECRET=sec_yndx_secret_mock_152fz
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback

# 2. OAuth2: Google Identity (Международный контур)
GOOGLE_CLIENT_ID=documind_google_oauth_client_prod
GOOGLE_CLIENT_SECRET=gsec_mock_token_production
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# 3. Аналитика: Яндекс.Метрика
YANDEX_METRIKA_COUNTER_ID=98765432
YANDEX_METRIKA_WEBVISOR=true

# 4. Платежи: ЮKassa
YOOKASSA_SHOP_ID=412095
YOOKASSA_SECRET_KEY=test_sKey_EnterpriseLicense_SecretToken
YOOKASSA_WEBHOOK_URL=http://localhost:8000/api/billing/webhook

# 5. Мониторинг
UPTIMEROBOT_API_KEY=ur987654-test-uptime-key
HEALTHCHECK_INTERVAL_SEC=30
